# 复制本文件为 .env 并填入真实值。.env 不要提交到 Git（见 .gitignore）

# ===== 数据库 =====
DATABASE_URL=mysql+pymysql://mewhelp:mewhelp_pass@127.0.0.1:3308/mewhelp_dev?charset=utf8mb4

# ===== Redis =====
REDIS_URL=redis://127.0.0.1:6380/0

# ===== JWT（生产务必替换为随机长字符串，至少 32 字节）=====
SECRET_KEY=please-generate-a-random-secret-at-least-32-bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===== 大模型（DeepSeek，OpenAI 兼容）=====
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# ===== 嵌入 / 重排（硅基流动）=====
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_TIMEOUT=30
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 留空则复用 EMBEDDING_API_KEY
RERANK_API_KEY=

# ===== Milvus =====
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=mewhelp_kb

# ===== RAG 行为参数 =====
RAG_TOP_K=5
RAG_RECALL_TOP_N=20
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
